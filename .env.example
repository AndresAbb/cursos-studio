# Copy this file to .env and edit values as needed.

# ─── MongoDB ────────────────────────────────────────────────────
# The connection string is built from the parts below. Both run setups
# share these values so they hit the SAME database:
#   • run_local.bat (native) → uses MONGO_HOST below (localhost)
#   • docker compose         → overrides MONGO_HOST to host.docker.internal
# Credentials (MONGO_USER / MONGO_PASS) are shared by both.
MONGO_HOST=localhost:27017
MONGO_DB=cursos_studio

# Leave USER/PASS empty to run WITHOUT auth (localhost-only dev).
# To enable auth: fill these in, run setup-mongo-auth.bat, then turn on
# `security.authorization: enabled` in mongod.cfg and restart MongoDB.
MONGO_USER=
MONGO_PASS=

# Admin/root user — only needed by setup-mongo-auth.bat (to create users
# and to re-run the script after auth is already enabled). Not used by
# the app at runtime.
MONGO_ADMIN_USER=
MONGO_ADMIN_PASS=

# Optional escape hatch: a full connection string (e.g. MongoDB Atlas).
# If set, it overrides ALL of the parts above.
# MONGODB_URI=

# HTTP port
PORT=3000

# ─── Authentication ─────────────────────────────────────────────
# If set, the app requires this password to access the UI and API.
# Leave UNSET (or empty) to disable auth — safe for localhost-only use.
# REQUIRED if you expose the app to the internet (e.g. port forwarding).
APP_PASSWORD=

# Optional: stable secret used to sign session cookies.
# If unset, a random secret is generated on each server start (sessions
# are invalidated on restart). Set this to keep users logged in across
# restarts. Any random ≥32-char string is fine.
AUTH_SECRET=

# ─── AI providers (optional) ────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Spotify (optional) ─────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
